{
  "name": "angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:boilerplate-user": "node dist/boilerplate-user/server/server.mjs",
    "serve:ssr:boilerplate-administrator": "node dist/boilerplate-administrator/server/server.mjs",
    "boilerplate-user:start:local": "ng serve boilerplate-user --port=5011",
    "boilerplate-administrator:start:local": "ng serve boilerplate-administrator --port=6011",
    "boilerplate:start:local": "concurrently --kill-others \"npm run boilerplate-user:start:local\" \"npm run boilerplate-administrator:start:local\""
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.8",
    "bootstrap": "^5.3.8",
    "express": "^5.1.0",
    "gsap": "^3.15.0",
    "lodash": "^4.18.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@types/express": "^5.0.1",
    "@types/lodash": "^4.17.25",
    "@types/node": "^20.17.19",
    "concurrently": "^9.2.4",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
