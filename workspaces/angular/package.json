{
  "name": "angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:boilerplate-user": "node dist/boilerplate-user/server/server.mjs",
    "serve:ssr:boilerplate-administrator": "node dist/boilerplate-administrator/server/server.mjs",
    "boilerplate-user:start:local": "ng serve boilerplate-user --port=5011",
    "boilerplate-administrator:start:local": "ng serve boilerplate-administrator --port=6011",
    "boilerplate:start:local": "concurrently --kill-others \"npm run boilerplate-user:start:local\" \"npm run boilerplate-administrator:start:local\""
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-server": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@angular/ssr": "^20.0.4",
    "bootstrap": "^5.3.7",
    "express": "^5.1.0",
    "gsap": "^3.13.0",
    "lodash": "^4.17.21",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.4",
    "@angular/cli": "^20.0.3",
    "@angular/compiler-cli": "^20.0.0",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/lodash": "^4.17.19",
    "@types/node": "^20.17.19",
    "concurrently": "^9.2.0",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.0.0",
    "typescript": "~5.8.2"
  }
}
