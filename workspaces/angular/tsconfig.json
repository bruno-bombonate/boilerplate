/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "@bruno-bombonate/ngx-authentication": [
        "./dist/bruno-bombonate/ngx-authentication"
      ],
      "@bruno-bombonate/ngx-classes": [
        "./dist/bruno-bombonate/ngx-classes"
      ],
      "@bruno-bombonate/ngx-forms": [
        "./dist/bruno-bombonate/ngx-forms"
      ],
      "@bruno-bombonate/ngx-seo": [
        "./dist/bruno-bombonate/ngx-seo"
      ],
      "@bruno-bombonate/ngx-toast": [
        "./dist/bruno-bombonate/ngx-toast"
      ]
    },
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/boilerplate-user/tsconfig.app.json"
    },
    {
      "path": "./projects/boilerplate-user/tsconfig.spec.json"
    },
    {
      "path": "./projects/boilerplate-administrator/tsconfig.app.json"
    },
    {
      "path": "./projects/boilerplate-administrator/tsconfig.spec.json"
    },
    {
      "path": "./projects/bruno-bombonate/ngx-classes/tsconfig.lib.json"
    },
    {
      "path": "./projects/bruno-bombonate/ngx-classes/tsconfig.spec.json"
    },
    {
      "path": "./projects/bruno-bombonate/ngx-toast/tsconfig.lib.json"
    },
    {
      "path": "./projects/bruno-bombonate/ngx-toast/tsconfig.spec.json"
    },
    {
      "path": "./projects/bruno-bombonate/ngx-authentication/tsconfig.lib.json"
    },
    {
      "path": "./projects/bruno-bombonate/ngx-authentication/tsconfig.spec.json"
    },
    {
      "path": "./projects/bruno-bombonate/ngx-seo/tsconfig.lib.json"
    },
    {
      "path": "./projects/bruno-bombonate/ngx-seo/tsconfig.spec.json"
    },
    {
      "path": "./projects/bruno-bombonate/ngx-forms/tsconfig.lib.json"
    },
    {
      "path": "./projects/bruno-bombonate/ngx-forms/tsconfig.spec.json"
    }
  ]
}
